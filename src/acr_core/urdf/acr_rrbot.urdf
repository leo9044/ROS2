<?xml version="1.0"?>
<robot name="acr_rrbot">
  <material name="body_white"><color rgba="0.82 0.85 0.88 1"/></material>
  <material name="joint_dark"><color rgba="0.08 0.10 0.12 1"/></material>
  <material name="accent_blue"><color rgba="0.05 0.35 0.85 1"/></material>
  <material name="connector_orange"><color rgba="1.0 0.35 0.02 1"/></material>

  <link name="world"/>
  <joint name="fixed" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0 0 0.25"/><geometry><cylinder length="0.50" radius="0.16"/></geometry><material name="body_white"/></visual>
    <visual><origin xyz="0 0 0.50"/><geometry><cylinder length="0.08" radius="0.20"/></geometry><material name="joint_dark"/></visual>
    <visual><origin xyz="0.13 0 0.28" rpy="0 0 0"/><geometry><box size="0.08 0.24 0.22"/></geometry><material name="accent_blue"/></visual>
    <collision><origin xyz="0 0 0.25"/><geometry><cylinder length="0.5" radius="0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 0.25"/><mass value="10.0"/><inertia ixx="0.23" ixy="0" ixz="0" iyy="0.23" iyz="0" izz="0.05"/></inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="link1">
    <visual><origin xyz="0 0 0.40"/><geometry><box size="0.16 0.18 0.78"/></geometry><material name="body_white"/></visual>
    <visual><origin xyz="0 0 0.40"/><geometry><cylinder length="0.82" radius="0.07"/></geometry><material name="accent_blue"/></visual>
    <visual><origin xyz="0 0 0.78"/><geometry><cylinder length="0.12" radius="0.15"/></geometry><material name="joint_dark"/></visual>
    <collision><origin xyz="0 0 0.4"/><geometry><box size="0.1 0.1 0.8"/></geometry></collision>
    <inertial><origin xyz="0 0 0.4"/><mass value="5.0"/><inertia ixx="0.27" ixy="0" ixz="0" iyy="0.27" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0 0 0.8"/>
    <axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>
  <link name="link2">
    <visual><origin xyz="0 0 0.30"/><geometry><box size="0.15 0.17 0.58"/></geometry><material name="body_white"/></visual>
    <visual><origin xyz="0 0 0.30"/><geometry><cylinder length="0.62" radius="0.065"/></geometry><material name="accent_blue"/></visual>
    <collision><origin xyz="0 0 0.3"/><geometry><box size="0.1 0.1 0.6"/></geometry></collision>
    <inertial><origin xyz="0 0 0.3"/><mass value="3.0"/><inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.005"/></inertial>
  </link>

  <joint name="tool0_fixed" type="fixed">
    <parent link="link2"/><child link="tool0"/><origin xyz="0 0 0.62"/>
  </joint>
  <link name="tool0">
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder length="0.16" radius="0.09"/></geometry><material name="connector_orange"/></visual>
    <visual><origin xyz="0 0 0.18"/><geometry><cylinder length="0.08" radius="0.045"/></geometry><material name="joint_dark"/></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><cylinder length="0.20" radius="0.09"/></geometry></collision>
    <inertial><origin xyz="0 0 0.1"/><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="lidar_fixed" type="fixed">
    <!-- Directly mounted on the side face of the charging nozzle end; no visual bridge. -->
    <parent link="tool0"/><child link="lidar_link"/><origin xyz="0.10 0 0.14" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.12 0.10 0.07"/></geometry><material name="joint_dark"/></visual>
  </link>

  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>30</update_rate>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan>
        <range><min>0.05</min><max>2.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name><topic>/cmd_pos</topic><initial_position>0.0</initial_position><use_velocity_commands>true</use_velocity_commands><cmd_max>0.5</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint2</joint_name><topic>/joint2_cmd_pos</topic><initial_position>0.0</initial_position><use_velocity_commands>true</use_velocity_commands><cmd_max>0.5</cmd_max>
    </plugin>
  </gazebo>
</robot>
